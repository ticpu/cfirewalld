#!/bin/bash

source fw_common.sh

# Define proper usage.
if [ ! -z ${1-} ]; then
	_fw_usage "
	No arguments needed, creates all chain and sub-chains before applying."
fi

add_chain () {
	$IPTABLES -t $1 -A ${FWTMP}delegate_$3 -j $2+$3
}

for V in 4 6
do
	eval "IPTABLES=\$IP${V}TABLES"
	eval "IPTABLES_SAVE=\$IP${V}TABLES_SAVE"

	for table in $IPTABLES_TABLES
	do
		# Read the built chains before creating anything: a table usually has
		# one or two hooks in use, and creating all of them to delete the rest
		# costs three invocations per hook per table per family.
		mapfile -t built < <($IPTABLES_SAVE -t $table | get_chains "$FWTMP" | sort -n)

		declare -A wanted=()
		for entry in "${built[@]}"
		do
			[ -z "$entry" ] && continue
			# A built chain is ZONE+HOOK; delegate_ chains are ours, not zones.
			[[ $entry == ${FWTMP}delegate_* ]] && continue
			hook="${entry##*+}"
			hook="${hook,,}"
			case " $IPTABLES_CHAINS " in
				*" $hook "*) wanted[$hook]+="${entry} ";;
			esac
		done

		for hook in "${!wanted[@]}"
		do
			$IPTABLES -t $table -N ${FWTMP}delegate_${hook} 2>/dev/null || true
			$IPTABLES -t $table -F ${FWTMP}delegate_${hook}
			for entry in ${wanted[$hook]}
			do
				$IPTABLES -t $table -A ${FWTMP}delegate_${hook} -j "$entry"
			done
		done

		unset wanted
	done
done

exit 0

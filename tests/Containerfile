FROM docker.io/library/debian:bookworm-slim

# ipset and iptables are what the firewall drives; dnsutils supplies dig for the
# BASH path. No DNS server is reachable, so tests use literals and the stub.
RUN apt-get update -qq \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
        bash iptables ipset dnsutils sudo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /cfirewalld

ARG BASE=docker.io/library/debian:bookworm-slim
FROM ${BASE}

# ipset and iptables are what the firewall drives; dnsutils supplies dig for the
# BASH path, and sudo is checked for at startup. No DNS server is reachable, so
# the fixture uses literals only.
RUN apt-get update -qq \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
        bash iptables ipset dnsutils sudo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /cfirewalld
